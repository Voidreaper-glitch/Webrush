{
  "name": "afterprint",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "AFTERPRINT — an evidence-led, frontend-only interactive archive.",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --import tsx --test tests/archive-codec.test.ts",
    "verify:data": "tsx scripts/verify-data.ts",
    "repair:story": "tsx scripts/repair-story.ts",
    "test:browser": "playwright test",
    "smoke": "npm run build && npm run test:browser",
    "verify": "npm run typecheck && npm run lint && npm test && npm run verify:data && npm run build && npm run test:browser"
  },
  "dependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^7.0.0",
    "tsx": "^4.20.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "@playwright/test": "^1.58.0",
    "@axe-core/playwright": "^4.11.0"
  }
}
